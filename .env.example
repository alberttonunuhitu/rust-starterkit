# Server
APP_SERVER__HOST="0.0.0.0"
APP_SERVER__PORT=8080

# Database
APP_DATABASE__URL=postgres://postgres@localhost:5432/rust_starterkit

APP_DATABASE__MAX_CONNECTIONS=15
APP_DATABASE__MIN_CONNECTIONS=2
APP_DATABASE__CONNECT_TIMEOUT=10
APP_DATABASE__ACQUIRE_TIMEOUT=8
APP_DATABASE__IDLE_TIMEOUT=300
APP_DATABASE__MAX_LIFETIME=1800

# Docker Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=rust_starterkit

# PASETO v4 Ed25519 — generate with: cargo run --bin generate-paseto-keys
# Use k4.secret.… (PASERK) or 128-char hex (32-byte seed || 32-byte public key)
APP_TOKEN__SECRET_KEY=
APP_TOKEN__EXPIRATION=15m
APP_TOKEN__REFRESH_SECRET_KEY=
APP_TOKEN__REFRESH_EXPIRATION=7d
APP_TOKEN__ISSUER=rust
APP_TOKEN__AUDIENCE=vue

# App Info
APP_APP__ENVIRONMENT=development

RUST_LOG=api=debug,actix_web=info